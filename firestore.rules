// Copie estas regras em: Firebase Console → Firestore Database → Regras
// Elas garantem que cada usuário só lê/escreve o que pode.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // USERS: cada usuário lê todos (pra mostrar ranking/avatar) mas só edita o próprio
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // GROUPS:
    // - LEITURA: qualquer usuário logado (necessário pra buscar grupo pelo código)
    // - CRIAR: precisa ser o creator e estar nos members iniciais
    // - UPDATE: só atualizando o array de members (entrar/sair), preservando outros campos
    match /groups/{groupId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.creator
                    && request.auth.uid in request.resource.data.members;

      // Permite apenas alterar 'members' (entrar/sair) — outros campos blindados
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['members']);
    }

    // PREDICTIONS: cada user escreve só os próprios; todos os logados leem
    match /predictions/{uid}/matches/{matchId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // SCORES (placares oficiais): leitura pública pra todo logado;
    // só escrita por Cloud Function (admin) — bloqueia client
    match /scores/{matchId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
