// Copie estas regras em: Firebase Console → Firestore Database → Regras
// Elas garantem que cada usuário só lê/escreve o que pode.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // USERS: cada usuário lê todos (pra mostrar ranking) mas só edita o próprio
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // GROUPS: lê quem é membro; cria qualquer logado;
    // membros podem se adicionar/remover (campo "members")
    match /groups/{groupId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.members;

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.creator
                    && request.auth.uid in request.resource.data.members;

      // Atualiza somente o array members (pra entrar/sair) — só o próprio uid
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.members
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['members']);
    }

    // PREDICTIONS: cada user escreve só os próprios; todos os logados leem
    match /predictions/{uid}/matches/{matchId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // SCORES (placares oficiais): leitura pública pra todo logado;
    // só escrita por Cloud Function (admin) — bloqueia client
    match /scores/{matchId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
